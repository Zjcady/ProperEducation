{
  "autoMemoryEnabled": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\" ] || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/after_coach.py\" ] || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/after_coach.py\"",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_guard.py\" ] || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
